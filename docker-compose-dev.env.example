# Copia este archivo a .env.dev en la raíz del proyecto y reemplaza los valores.
# Esta configuración es solo para desarrollo; no reutilices credenciales de producción.
DB_PASS=Reemplazar_Con_Clave_Local_Fuerte_123!
DB_NAME=iCalidadDev
DEV_SQL_PORT=14333
DEV_HTTP_PORT=8085

# Valores locales de desarrollo. Genera claves distintas para cada entorno.
JWT_SECRET=local-dev-JWT-secret-replace-with-random-32-byte-value
JWT_ISSUER=iCalidadAPI
JWT_AUDIENCE=iCalidadClients
NEXTAUTH_SECRET=local-dev-NextAuth-secret-replace-with-random-value
SECRET=local-development-only
